{
  "manifest_version": 3,
  "name": "예약 브라우저 캡처",
  "version": "1.0.0",
  "description": "탭별 일정에 따라 화면을 캡처하여 저장합니다.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "debugger", "downloads", "storage", "tabs"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "예약 캡처 설정"},
  "options_page": "options.html"
}